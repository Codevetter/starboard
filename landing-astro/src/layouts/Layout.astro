---
import '@/styles/landing.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import { canonicalPath } from '@/lib/canonical';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const SITE_URL = 'https://starboard.codevetter.com';
const canonicalUrl = new URL(canonicalPath(Astro.url.pathname), SITE_URL).href;
// OG image lives on the Next.js Worker at /opengraph-image (Next file
// convention → dynamic JSX → PNG). The single-Worker overlay keeps that
// route on the OpenNext side, so this URL still resolves.
const OG_IMAGE = `${SITE_URL}/opengraph-image`;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Starboard',
  url: SITE_URL,
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web Browser',
  isAccessibleForFree: true,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  creator: {
    '@type': 'Person',
    name: 'Sarthak Agrawal',
    url: 'https://sarthakagrawal.dev',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content="Starboard" />
    <meta name="theme-color" content="#f4efe4" />
    <meta
      name="keywords"
      content="project-aware tool discovery, GitHub repository discovery, open source tools, GitHub stars organizer, tool intelligence"
    />

    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="text/markdown"
      href={new URL(Astro.url.pathname === '/' ? '/index.md' : `${Astro.url.pathname}.md`, SITE_URL)}
    />
    <link rel="alternate" type="text/plain" href={new URL('/llms.txt', SITE_URL)} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Starboard" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={OG_IMAGE} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={OG_IMAGE} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>

    {/* ── Fonts ────────────────────────────────────────────────────
       Self-hosted via @fontsource-variable/{geist,geist-mono} (imported
       in the frontmatter). Astro/Vite inlines the @font-face into the
       page CSS and serves the woff2 from /_astro/ same-origin, so there
       is no external CSS fetch on the LCP path. font-display: swap is
       preserved by Fontsource. Only Geist (the LCP-h1 face) is the
       critical path; Geist Mono is shipped alongside but is not
       LCP-critical. */}

    {/* Wire the same CSS vars Next.js's next/font sets up, so any
       Tailwind class using --font-geist-sans / --font-geist-mono keeps
       working without a rebuild. Fontsource registers the families as
       'Geist Variable' / 'Geist Mono Variable'. */}
    <style is:inline>
      :root {
        --font-geist-sans: 'Geist Variable', system-ui, -apple-system, sans-serif;
        --font-geist-mono: 'Geist Mono Variable', ui-monospace, Menlo, monospace;
      }
      html { color-scheme: light; }
      body { margin: 0; }
      portfolio-project-strip,
      ai-chat-footer { display: block; }
      portfolio-project-strip { min-height: 2.875rem; }
      ai-chat-footer { min-height: 6rem; }
      @media (max-width: 1000px) {
        ai-chat-footer { min-height: 9rem; }
      }
    </style>
  </head>
  <body class="antialiased">
    <slot />
    <portfolio-project-strip current-project="starboard"></portfolio-project-strip>
    <ai-chat-footer product-name="Starboard"></ai-chat-footer>
    <script is:inline src="/project-strip.js" data-project="starboard" defer></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="Starboard"
      data-compose="false"
      defer
    ></script>
  </body>
</html>
