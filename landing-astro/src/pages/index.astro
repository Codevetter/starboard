---
import Base from '@saas-maker/templates/Base.astro';
import { WorkbenchPage } from '@saas-maker/templates/workbench-page';
import { baseProps } from '@saas-maker/templates/page';
import { workbenchContent } from '@saas-maker/templates/schema';
import home from '../content/home.json';

const content = workbenchContent.parse(home);
// v0.1.13 validates absolute form URLs; keep the original same-origin GET route.
if (content.hero.form) content.hero.form.action = new URL(content.hero.form.action).pathname;
---

<Base {...baseProps(content)}>
  <Fragment slot="head">
    <meta name="application-name" content="Starboard" />
    <meta name="theme-color" content="#f4efe4" />
    <meta
      name="keywords"
      content="project-aware tool discovery, GitHub repository discovery, open source tools, GitHub stars organizer, tool intelligence"
    />
    <link rel="alternate" type="text/markdown" href="https://starboard.codevetter.com/index.md" />
    <link rel="alternate" type="text/plain" href="https://starboard.codevetter.com/llms.txt" />
    <script is:inline src="/app-health-log.js" defer></script>
    <script
      is:inline
      defer
      src="https://health.sassmaker.com/tracker.js"
      data-key="ahk_pub_c51dbbf523477f116fa158a0f255be9e625a7626e91ec2c29a9c1890d430abe9"
      data-project="app-cd5de47f-b205-4f47-aa3b-be88833bcf00"
      data-identity="persistent"
      data-endpoint="https://ingest.sassmaker.com/v1/browser"
      data-vitals
      data-vitals-routes="articles,changelog"
    ></script>
    <script is:inline>
      // Template links have no attribute field. Attach the existing logging
      // contract in capture phase before the hosted logger handles the click.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const submit = event.target.closest('[data-identity-form] button[type="submit"]');
        if (submit) submit.setAttribute('data-log', 'project_preview_cta_clicked');
        const link = event.target.closest('a[href]');
        if (!link) return;
        const events = {
          '/project-preview': 'project_preview_cta_clicked',
          '/discover': 'public_catalog_browsed',
          '/login': 'github_connect_started',
        };
        const name = events[link.getAttribute('href')];
        if (name) link.setAttribute('data-log', name);
      }, true);
    </script>
    <script>
      import '../scripts/app-health-flush';
    </script>
  </Fragment>
  <WorkbenchPage content={content} />
</Base>

<style is:global>
  .identity-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
</style>
