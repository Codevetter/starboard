// Cloudflare Workers config for opennextjs-cloudflare deploy.
// Run `pnpm deploy:cf` to publish.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "starboard",
  "main": "worker.mjs",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "limits": {
    "cpu_ms": 30000
  },
  "routes": [
    {
      "pattern": "starboard.codevetter.com",
      "custom_domain": true
    }
  ],
  // Workers AI binding — replaces the AI Gateway HTTP layer for embeddings.
  // The seed-popular GH Action still uses HTTP since it runs in Node.
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "starboard",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vectorize": [
    {
      "binding": "REPO_VECTORS",
      "index_name": "starboard-repos"
    }
  ],
  // Set non-secret values here. Secrets go via `wrangler secret put`:
  //   AUTH_SECRET, AUTH_GITHUB_ID, AUTH_GITHUB_SECRET
  // AI_GATEWAY_URL/KEY only needed if you want to keep the gateway path active.
  "vars": {
    "NEXT_PUBLIC_APP_NAME": "starboard",
    "AUTH_URL": "https://starboard.codevetter.com",
    "NEXTAUTH_URL": "https://starboard.codevetter.com",
    "WRITE_FREEZE": "false",
    "STARBOARD_RAG_INDEX_ID": "16522a1b-afe6-4167-99d7-d00695ee271a"
  },
  "services": [
    {
      "binding": "RAG_SERVICE",
      "service": "knowledgebase"
    }
  ]
}
